# ===== 应用 =====
APP_ENV=dev
SECRET_KEY=please-change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
# 启动时自动建表（含 vector 扩展），生产环境建议关闭
AUTO_CREATE_TABLES=true

# ===== 数据库（Docker 内使用 db 主机名，本机开发使用 localhost）=====
DATABASE_URL=postgresql+asyncpg://ecommerce:ecommerce@localhost:5432/ecommerce

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== LLM（ollama | openai）=====
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
# 云端备选（OpenAI 兼容端点）
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
# 向量维度：nomic-embed-text=768，text-embedding-3-small=1536
EMBED_DIM=768

# ===== 业务 =====
PAYMENT_MOCK=true
ORDER_TIMEOUT_MINUTES=15
